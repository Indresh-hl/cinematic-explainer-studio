assets/images/4k/
assets/images/raw/
assets/images/cleaned/
assets/images/raw_upscaled/
assets/cutouts/
production/**/images/
production/**/cutouts/
production/**/renders/
production/**/audio/chunks/
production/**/audio/temp/


# Binary Models, DLLs, Archives & Executables
*.bin
*.param
*.dll
*.zip
*.tar.gz
tools/realesrgan/
tools/realesrgan-windows.zip
assets/models/
assets/images/download.zip
snapshots/

# Node & HyperFrames
node_modules/
.cache/
