# Keep configs, manifests, json timelines, fonts, and verification frames
!assets/*.json
!assets/fonts/
!assets/verification_frames/
!assets/sampled_frame_*.jpg
!assets/act1_verify_*.jpg

# Scratch & Test Cache
scratch/
.pytest_cache/
.agents/

